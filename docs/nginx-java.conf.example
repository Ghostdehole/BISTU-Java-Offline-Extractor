# Merge this snippet INSIDE the existing site's server { ... } block.
# Keep the current root, server_name, listen, TLS and other site configuration.
# It assumes /java/ is the existing subdirectory under that server's root.
# If this site uses alias or a root defined only in another location, adapt
# the filesystem mapping first; do not paste a guessed server directory here.
#
# Place BOTH regex locations below BEFORE generic regex locations for .js,
# images, downloads, etc. Merge any existing conflicting /java/ locations.
# An existing `location ^~ /java/` would suppress these regex locations.
#
# IMPORTANT: add_header at a location changes inheritance of existing
# add_header directives. Preserve required site security headers by repeating
# them or including the site's existing shared header snippet in these blocks.

location = /java {
    return 308 /java/;
}

# Both public entry URLs receive the same validation policy.
location = /java/ {
    try_files /java/index.html =404;
    types { }
    default_type text/html;
    expires off;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
}

location = /java/index.html {
    try_files $uri =404;
    types { }
    default_type text/html;
    expires off;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
}

# The 32-character ID is generated by the exporter. Never rename the file
# or replace its contents under an already published filename.
location ~ "^/java/question-images\.[a-f0-9]{32}\.pack\.js$" {
    try_files $uri =404;
    types { }
    default_type application/javascript;
    expires off;
    # No `always`: missing files must not receive a year-long cache policy.
    add_header Cache-Control "public, max-age=31536000, immutable";

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript;
}

# Publish only index.html and versioned image packs in this directory.
# This blocks accidentally uploaded plaintext images/, ZIP backups,
# state.json, extraction-report.json and other files under /java/.
# Keep it AFTER the allowed pack regex and BEFORE generic site regexes.
location ~ ^/java/ {
    return 404;
}
